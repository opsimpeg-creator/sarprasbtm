# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# GOOGLE SHEETS CONFIGURATION
# Google Spreadsheet ID used as primary database
GOOGLE_SHEETS_ID="your_google_spreadsheet_id_here"

# Google Apps Script Web App URL for real-time insert/update/delete sync
GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/your_deployment_id/exec"

# FIREBASE CONFIGURATION (Optional - for Firebase Authentication & Storage)
# Obtain these from Firebase Console > Project Settings > Web App
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

